// Windows resources: the app icon (the Mac app's, from Resources/AppIcon-1024.png;
// SDL uses the first icon for the window and taskbar too) and version info.
#include <winver.h>

1 ICON "../AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,4,1,0
PRODUCTVERSION  0,4,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Vintage Click"
      VALUE "ProductName", "Vintage Click"
      VALUE "FileVersion", "0.4.1"
      VALUE "ProductVersion", "0.4.1"
      VALUE "OriginalFilename", "VintageClick.exe"
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
