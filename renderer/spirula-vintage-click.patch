+void capture_frame_size(int resolution, int& W, int& H) {
+    switch (resolution) {
+        case 2:  W = 3840; H = 2160; break;
+        case 1:  W = 2560; H = 1440; break;
+        default: W = 1920; H = 1080; break;
+    }
