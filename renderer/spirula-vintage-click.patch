new file mode 100644
index 00000000..8a4d4a21
--- /dev/null
+++ b/src/backend/vulkan/MetalInterop.cpp
@@ -0,0 +1,40 @@
+// See MetalInterop.h.
+
+#include "backend/vulkan/MetalInterop.h"
+
+#include "backend/vulkan/VulkanInternal.h"
+
+#if defined(__APPLE__)
+#include <vulkan/vulkan_metal.h>
+#endif
+
+namespace backend {
+namespace vk {
+
+void* metal_buffer_for(const void* device_ptr, size_t* offset) {
+#if defined(__APPLE__)
+    Allocation alloc;
+    VkDeviceSize off = 0;
+    bool is_device = false;
+    if (!resolve_pointer(device_ptr, &alloc, &off, &is_device) || !is_device)
+        return nullptr;
+    VkDevice dev = Context::get().device();
+    auto fn = (PFN_vkExportMetalObjectsEXT)vkGetDeviceProcAddr(
+        dev, "vkExportMetalObjectsEXT");
+    if (!fn) return nullptr;
+    VkExportMetalBufferInfoEXT buf{VK_STRUCTURE_TYPE_EXPORT_METAL_BUFFER_INFO_EXT};
+    buf.memory = alloc.memory;
+    VkExportMetalObjectsInfoEXT info{VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT};
+    info.pNext = &buf;
+    fn(dev, &info);
+    if (offset) *offset = (size_t)off;
+    return (void*)buf.mtlBuffer;
+#else
+    (void)device_ptr;
+    (void)offset;
+    return nullptr;
+#endif
+}
+
+}  // namespace vk
+}  // namespace backend
